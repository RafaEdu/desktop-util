{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "productName": "Adcontec Útil",
  "version": "5.1.3",
  "identifier": "com.adcontec-util.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Adcontec Útil",
        "width": 420,
        "height": 600,
        "resizable": true,
        "dragDropEnabled": true,
        "decorations": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "AD CONTEC Contabilidade LTDA",
    "resources": {
      "../remote-session-scripts/Fechar-Dominio.ps1": "remote-session-scripts/Fechar-Dominio.ps1",
      "../remote-session-scripts/Encerrar-Sessao.ps1": "remote-session-scripts/Encerrar-Sessao.ps1"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
