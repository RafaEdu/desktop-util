{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capabilities for the main window",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",

    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-decorations",
    "core:window:allow-set-size",
    "core:window:allow-center",
    "core:window:allow-current-monitor",
    "core:window:allow-outer-size",

    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute",

    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",

    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",

    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://www.esocial.gov.br/**"
        },
        {
          "url": "https://www.gov.br/**"
        },
        {
          "url": "https://sd.maisemprego.mte.gov.br/**"
        },
        {
          "url": "https://www.nfe.fazenda.gov.br/**"
        },
        {
          "url": "https://cav.receita.fazenda.gov.br/**"
        },
        {
          "url": "https://www.nfse.gov.br/**"
        }
      ]
    },

    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$DESKTOP/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$TEMP/**"
        }
      ]
    },

    "fs:allow-write-file"
  ]
}
